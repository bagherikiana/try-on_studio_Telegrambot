# Copy to .env.local and fill in. Real values come from: npx neonctl env pull
# Never commit .env.local or .env.n8n.local (both are git-ignored).

# Pooled connection (apps and n8n)
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct connection (migrations and admin scripts)
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
NEON_BRANCH=main

# .env.n8n.local is written by `npm run db:app-password` and holds N8N_DATABASE_URL (the n8n_app login).
