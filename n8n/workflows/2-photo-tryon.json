    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// n8n Code node \"Validate Photo\" in workflow \"Try-On Bot · 2 · Photo & Try-On\".\n// Mode: Run Once for Each Item. Rejects photos the AI cannot use well.\nconst p = $json.photo;\nconst MAX_BYTES = 10 * 1024 * 1024;\nconst MIN_SIDE = 384;\nconst OK_TYPES = ['image/jpeg', 'image/png', 'image/webp'];\nconst maxMb = (MAX_BYTES / 1024 / 1024).toLocaleString('fa-IR');\n\nconst MESSAGES = {\n  no_photo:   'عکسی دریافت نشد. لطفاً دوباره بفرستید.',\n  bad_format: 'فقط عکس با فرمت JPG، PNG یا WEBP قابل قبول است.',\n  too_large:  `حجم عکس بیشتر از ${maxMb} مگابایت است. لطفاً عکس کوچک‌تری بفرستید.`,\n  too_small:  'کیفیت عکس خیلی پایین است. لطفاً عکس واضح‌تری بفرستید.',\n};\n\nlet error = null;\nif (!p?.file_id) error = 'no_photo';\nelse if (p.mime_type && !OK_TYPES.includes(p.mime_type)) error = 'bad_format';\n// A missing size counts as too large: Telegram cannot download files over 20 MB.\nelse if ((p.file_size ?? Infinity) > MAX_BYTES) error = 'too_large';\nelse if (p.width && p.height && Math.min(p.width, p.height) < MIN_SIDE) error = 'too_small';\n\nreturn {\n  json: { ...$json, photo_valid: !error, photo_error: error, photo_error_text: MESSAGES[error] ?? null },\n};\n"
      },
      "id": "6e005d54-35cf-47cc-9ef0-e935d1ec991b",
      "name": "Validate Photo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        272
      ],
      "notes": "Checks format (JPG/PNG/WEBP), size (<=10MB, missing size = too large) and resolution (min side 384px). Source: n8n/code/tryon-validate-photo.js"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// n8n Code node \"Pack Images\" in workflow \"Try-On Bot · 2 · Photo & Try-On\".\n// Mode: Run Once for Each Item. Puts both downloaded photos on one item\n// (binary \"person\" and \"garment\") so one HTTP request can send both to the image provider.\nconst person = $('Download Person').item.binary?.data;\nconst garment = $input.item.binary?.data;\nif (!person || !garment) {\n  throw new Error(`Missing image: person=${!!person}, garment=${!!garment}`);\n}\n\nconst job = $('Start Job').item.json;\nreturn {\n  json: { job_id: job.job_id, model: job.model, prompt_version: job.prompt_version },\n  binary: { person, garment },\n};\n"
      },
