        "postgres": {
          "id": "xrYTQ6UNYnQK1Ct1",
          "name": "Postgres n8n_app"
        }
      },
      "notes": "One statement: saves the person photo and moves the user to AWAIT_GARMENT with person_photo_id in state_data."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tryon.photos (user_id, kind, telegram_file_id, file_unique_id, width, height, file_size)\nVALUES ($1, 'garment', $2, $3, $4, $5, $6)\nRETURNING id AS garment_photo_id;",
        "options": {
          "queryReplacement": "={{ [$json.user_id, $json.photo.file_id, $json.photo.file_unique_id, $json.photo.width, $json.photo.height, $json.photo.file_size] }}",
