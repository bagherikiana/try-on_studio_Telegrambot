    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH p AS (\n  INSERT INTO tryon.photos (user_id, kind, telegram_file_id, file_unique_id, width, height, file_size)\n  VALUES ($1, 'person', $2, $3, $4, $5, $6)\n  RETURNING id\n)\nUPDATE tryon.users u\n   SET state = 'AWAIT_GARMENT',\n       state_data = jsonb_build_object('person_photo_id', p.id)\n  FROM p\n WHERE u.id = $1\nRETURNING p.id AS person_photo_id, u.state;",
        "options": {
          "queryReplacement": "={{ [$json.user_id, $json.photo.file_id, $json.photo.file_unique_id, $json.photo.width, $json.photo.height, $json.photo.file_size] }}",
          "largeNumbersOutput": "numbers",
          "replaceEmptyStrings": true
        }
      },
      "id": "21276a2a-4343-424b-9557-9c1251d2cb16",
      "name": "Save Person Photo",
      "type": "n8n-nodes-base.postgres",
